---
import { getCollection } from 'astro:content';
import Hero from '../components/Sections/Hero.astro';
import About from '../components/Sections/About.astro';
import Skills from '../components/Sections/Skills.astro';
import Experience from '../components/Sections/Experience.astro';
import Contact from '../components/Sections/Contact.astro';
import Stats from '../components/Sections/Stats.astro';

const profile = (await import('../content/profile.json')).default;
const skills = (await import('../content/profile.json')).default.skills;
const projects = await getCollection('projects');
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0D0D0D">
  <meta name="description" content="Carlos de Jesus Martinez Pineda - Estudiante Ingeniería en Software | Build. Scale. Optimize.">
  <meta name="keywords" content="Software Engineering, Developer, Portfolio, Full Stack, JavaScript, Python, Java, C++">
  <meta name="author" content="Carlos de Jesus Martinez Pineda">
  
  <meta property="og:type" content="website">
  <meta property="og:title" content="Carlos de Jesus Martinez Pineda | Software Engineering Student">
  <meta property="og:description" content="Build. Scale. Optimize. - Portfolio de Carlos de Jesus Martinez Pineda">
  <meta property="og:image" content="/assets/images/yopro.jpeg">
  <meta property="og:url" content="https://charcraft.github.io/CXRLOSMP-LANDING/">
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Carlos de Jesus Martinez Pineda | Software Engineering Student">
  <meta name="twitter:description" content="Build. Scale. Optimize.">
  <meta name="twitter:image" content="/assets/images/yopro.jpeg">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="font" type="font/woff2" crossorigin href="https://fonts.gstatic.com/s/pressstart2p/v15/e3t4euO8T-267oIAQAu6jDQyK3nVivM.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="https://fonts.gstatic.com/s/notosansjp/v19/zYXgKvElMYYaJe8bpLHnCwDKjQ.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="https://fonts.gstatic.com/s/jetbrainsmono/v19/tDbD2oWUg0MKZDbi2BQ6PCVYTk5h6g.woff2">
  
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/letra-c.png">
  <link rel="apple-touch-icon" href="/assets/images/letra-c.png">
  <link rel="manifest" href="/manifest.json">
  
  <title>Carlos de Jesus Martinez Pineda | Ingeniería en Software</title>
</head>
<body>
  <!-- Global overlays -->
  <div class="scanlines" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  
  <!-- P3 Menu Navigation -->
  <div id="p3-menu-container"></div>
  
  <!-- Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-fusion-bg/80 backdrop-blur-xl border-b border-p5-red-dim/30" role="banner" style="height: var(--header-h);">
    <nav class="nav-container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full" aria-label="Navegación principal" style="height: var(--header-h);">
      <a href="#hero" class="logo flex items-center gap-2" aria-label="Ir al inicio">
        <img src="/assets/images/letra-c.png" alt="" class="logo-img w-8 h-8 md:w-10 md:h-10" width="40" height="40">
        <span class="hidden md:inline font-display text-sm md:text-base text-fusion-highlight">CXRLOSMP</span>
      </a>
      
      <button class="nav-toggle md:hidden flex flex-col items-center justify-center gap-1.5 w-10 h-10 p-0 bg-transparent border border-p5-red-dim rounded text-fusion-accent-primary" 
              type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="p3-menu">
        <span class="nav-toggle-bar w-5 h-0.5 bg-fusion-accent-primary transition-all duration-300"></span>
        <span class="nav-toggle-bar w-5 h-0.5 bg-fusion-accent-primary transition-all duration-300"></span>
        <span class="nav-toggle-bar w-5 h-0.5 bg-fusion-accent-primary transition-all duration-300"></span>
      </button>
    </nav>
  </header>
  
  <!-- Nav Menu (Desktop) -->
  <nav class="nav-menu hidden md:block fixed top-0 right-0 bottom-0 z-50 w-80 bg-fusion-bg/98 backdrop-blur-xl border-l border-p5-red-dim transform translate-x-full transition-transform duration-500 ease-out md:translate-x-0 md:static md:h-auto md:w-auto md:bg-transparent md:border-none md:flex md:items-center md:justify-end" id="nav-menu" aria-label="Menú de secciones" style="top: var(--header-h);">
    <ul class="nav-links flex flex-col md:flex-row md:items-center gap-1 md:gap-4 px-6 py-8 md:px-0 md:py-0">
      <li><a href="#hero" class="nav-link">Inicio</a></li>
      <li><a href="#about" class="nav-link">Sobre mí</a></li>
      <li><a href="#skills" class="nav-link">Skills</a></li>
      <li><a href="#projects" class="nav-link">Proyectos</a></li>
      <li><a href="#experience" class="nav-link">Experiencia</a></li>
      <li><a href="#stats" class="nav-link">Stats</a></li>
      <li><a href="#contact" class="nav-link">Contacto</a></li>
    </ul>
  </nav>
  
  <div class="nav-overlay hidden md:hidden fixed inset-0 bg-fusion-bg/60 z-40 opacity-0 transition-opacity duration-300" id="nav-overlay" hidden style="top: var(--header-h);"></div>
  
  <main>
    <Hero profile={profile} />
    <About profile={profile} />
    <Skills skills={skills} />
    
    <!-- Projects Section with Disc Carousel -->
    <section id="projects" class="py-20 md:py-32 px-4 sm:px-6 lg:px-8" aria-labelledby="projects-title" style="scroll-margin-top: var(--header-h);">
      <div class="max-w-7xl mx-auto">
        <h2 id="projects-title" class="section-title text-center">
          Proyectos <span>Destacados</span>
        </h2>
        
        <div id="disc-carousel" class="w-full"></div>
      </div>
    </section>
    
    <Experience />
    <Stats profile={profile} />
    <Contact profile={profile} />
  </main>
  
  <footer class="py-8 px-4 border-t border-p5-red-dim/30" role="contentinfo">
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-fusion-text-muted text-sm">
        &copy; {new Date().getFullYear()} {profile.name}. 
        Desarrollado con <span class="text-fusion-accent-primary">♥</span>, 
        <span class="text-fusion-highlight">Three.js</span> y 
        <span class="text-fusion-accent-tertiary">GSAP</span>.
      </p>
    </div>
  </footer>

  <!-- P3 Menu Container -->
  <div id="p3-menu-container"></div>
</body>