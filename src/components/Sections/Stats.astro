---
interface Props {
  profile: any;
}
const { profile } = Astro.props;
---

<section id="stats" class="py-20 md:py-32 px-4 sm:px-6 lg:px-8 bg-fusion-bg-secondary/30" aria-labelledby="stats-title" style="scroll-margin-top: var(--header-h);">
  <div class="max-w-7xl mx-auto">
    <h2 id="stats-title" class="section-title text-center">
      Stats <span>& GitHub</span>
    </h2>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
      <div class="stat-card card-p5 p-6 text-center group">
        <div class="stat-icon text-4xl mb-3 group-hover:animate-float-slow transition-all duration-500">📊</div>
        <div class="stat-value font-display text-4xl md:text-5xl text-fusion-highlight mb-1" id="stat-repos">—</div>
        <div class="stat-label font-display text-xs text-fusion-text-muted uppercase tracking-wider">Repositorios</div>
      </div>
      <div class="stat-card card-p5 p-6 text-center group">
        <div class="stat-icon text-4xl mb-3 group-hover:animate-float-slow transition-all duration-500">⭐</div>
        <div class="stat-value font-display text-4xl md:text-5xl text-fusion-accent-primary mb-1" id="stat-stars">—</div>
        <div class="stat-label font-display text-xs text-fusion-text-muted uppercase tracking-wider">Estrellas</div>
      </div>
      <div class="stat-card card-p5 p-6 text-center group">
        <div class="stat-icon text-4xl mb-3 group-hover:animate-float-slow transition-all duration-500">🍴</div>
        <div class="stat-value font-display text-4xl md:text-5xl text-fusion-accent-secondary mb-1" id="stat-forks">—</div>
        <div class="stat-label font-display text-xs text-fusion-text-muted uppercase tracking-wider">Forks</div>
      </div>
      <div class="stat-card card-p5 p-6 text-center group">
        <div class="stat-icon text-4xl mb-3 group-hover:animate-float-slow transition-all duration-500">👥</div>
        <div class="stat-value font-display text-4xl md:text-5xl text-fusion-accent-tertiary mb-1" id="stat-followers">—</div>
        <div class="stat-label font-display text-xs text-fusion-text-muted uppercase tracking-wider">Seguidores</div>
      </div>
    </div>
    
    <!-- Contribution graph placeholder -->
    <div class="card-p5 p-8">
      <h3 class="font-display text-xl text-fusion-highlight mb-6 text-center">Actividad Reciente</h3>
      <div class="contribution-grid grid grid-cols-53 gap-0.5 max-w-5xl mx-auto" id="contribution-graph" role="img" aria-label="Gráfico de contribuciones de GitHub">
        <!-- Generado dinámicamente -->
      </div>
      <div class="flex justify-center gap-4 mt-6 text-fusion-text-muted text-xs">
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-sm bg-fusion-bg-secondary"></span> Sin contribuciones</span>
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-sm bg-fusion-accent-primary/30"></span> 1-3</span>
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-sm bg-fusion-accent-primary/60"></span> 4-6</span>
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-sm bg-fusion-accent-primary"></span> 7+</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Fetch GitHub stats
  async function fetchGitHubStats() {
    try {
      const username = 'Charcraft';
      const response = await fetch(`https://api.github.com/users/${username}`);
      if (!response.ok) throw new Error('Failed to fetch');
      const data = await response.json();
      
      document.getElementById('stat-repos').textContent = data.public_repos.toLocaleString();
      document.getElementById('stat-followers').textContent = data.followers.toLocaleString();
      
      // Fetch repos for stars/forks
      const reposResponse = await fetch(`https://api.github.com/users/${username}/repos?per_page=100`);
      const repos = await reposResponse.json();
      const totalStars = repos.reduce((sum, repo) => sum + repo.stargazers_count, 0);
      const totalForks = repos.reduce((sum, repo) => sum + repo.forks_count, 0);
      
      document.getElementById('stat-stars').textContent = totalStars.toLocaleString();
      document.getElementById('stat-forks').textContent = totalForks.toLocaleString();
    } catch (error) {
      console.warn('GitHub stats unavailable:', error);
      // Fallback values
      document.getElementById('stat-repos').textContent = '2';
      document.getElementById('stat-stars').textContent = '0';
      document.getElementById('stat-forks').textContent = '0';
      document.getElementById('stat-followers').textContent = '0';
    }
  }
  
  fetchGitHubStats();
  
  // Generate contribution graph (simplified)
  function generateContributionGraph() {
    const container = document.getElementById('contribution-graph');
    if (!container) return;
    
    const today = new Date();
    const yearAgo = new Date(today.getFullYear() - 1, today.getMonth(), today.getDate());
    const daysDiff = Math.floor((today - yearAgo) / (1000 * 60 * 60 * 24));
    const startDay = yearAgo.getDay();
    
    // Clear container
    container.innerHTML = '';
    
    // Generate 53 weeks x 7 days
    for (let week = 0; week < 53; week++) {
      for (let day = 0; day < 7; day++) {
        const dayIndex = week * 7 + day + startDay;
        const date = new Date(yearAgo);
        date.setDate(date.getDate() + dayIndex);
        
        const cell = document.createElement('div');
        cell.className = 'w-3 h-3 rounded-sm transition-all duration-300';
        
        if (date > today) {
          cell.classList.add('bg-fusion-bg-secondary');
        } else {
          // Random contribution level for demo
          const level = Math.random();
          if (level < 0.7) {
            cell.classList.add('bg-fusion-bg-secondary');
          } else if (level < 0.85) {
            cell.classList.add('bg-fusion-accent-primary/30');
          } else if (level < 0.95) {
            cell.classList.add('bg-fusion-accent-primary/60');
          } else {
            cell.classList.add('bg-fusion-accent-primary');
          }
        }
        
        cell.style.borderRadius = '3px';
        cell.title = date.toLocaleDateString();
        container.appendChild(cell);
      }
    }
    
    generateContributionGraph();
  }
</script>